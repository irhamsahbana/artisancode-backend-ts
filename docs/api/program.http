@baseUrl = http://localhost:3000/api
@authToken = <paste_token_here>

### Create Program
POST {{baseUrl}}/programs
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Piano Beginner",
  "description": "Basic piano course",
  "status": "active",
  "branch_id": "replace-with-uuid",
  "age_category_id": "replace-with-uuid"
}

### Get Program List
GET {{baseUrl}}/programs?page=1&limit=10
Authorization: Bearer {{authToken}}

### Get Program by ID
GET {{baseUrl}}/programs/replace-with-uuid
Authorization: Bearer {{authToken}}

### Update Program
PUT {{baseUrl}}/programs/replace-with-uuid
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Piano Beginner Updated",
  "status": "active"
}

### Delete Program
DELETE {{baseUrl}}/programs/replace-with-uuid
Authorization: Bearer {{authToken}}

### Add Schedule
POST {{baseUrl}}/programs/replace-with-uuid/schedules
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "day": "monday",
  "start_time": "09:00",
  "end_time": "10:00"
}

### Add Pricing
POST {{baseUrl}}/programs/replace-with-uuid/pricings
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Monthly Fee",
  "prices": [
    {
      "currency": "IDR",
      "price": 500000
    }
  ]
}
