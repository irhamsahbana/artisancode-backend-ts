@baseUrl = http://localhost:3000/api
@authToken = <paste_token_here>

### Create Enrollment
POST {{baseUrl}}/enrollments
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "branch_id": "replace-with-uuid",
  "student_id": "replace-with-uuid",
  "program_id": "replace-with-uuid",
  "status": "active",
  "billing_type": "monthly"
}

### Get Enrollment List
GET {{baseUrl}}/enrollments?page=1&limit=10
Authorization: Bearer {{authToken}}

### Get Enrollment by ID
GET {{baseUrl}}/enrollments/replace-with-uuid
Authorization: Bearer {{authToken}}

### Update Enrollment
PUT {{baseUrl}}/enrollments/replace-with-uuid
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "status": "active",
  "billing_type": "monthly"
}

### Delete Enrollment
DELETE {{baseUrl}}/enrollments/replace-with-uuid
Authorization: Bearer {{authToken}}
