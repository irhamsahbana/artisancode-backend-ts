model Student {
    id                    String        @id @default(uuid(7))
    companyId             String        @map("company_id")
    branchId              String        @map("branch_id")
    firstName             String        @default("")
    lastName              String        @default("")
    gender                String        @default("")
    dateOfBirth           DateTime      @map("date_of_birth")
    birthPlace            String        @default("") @map("birth_place")
    email                 String        @default("") @map("email")
    address               String        @default("") @map("address")
    photoUrl              String        @default("") @map("photo_url")
    parentName            String        @default("") @map("parent_name")
    parentPhone           String        @default("") @map("parent_phone")
    parentEmail           String        @default("") @map("parent_email")
    emergencyContactPhone String        @default("") @map("emergency_contact_phone")
    bloodType             String        @default("") @map("blood_type")
    medicalNotes          String        @default("") @map("medical_notes")
    status                StudentStatus @default(active)
    createdAt             DateTime      @default(now()) @map("created_at")
    updatedAt             DateTime      @updatedAt @map("updated_at")
    deletedAt             DateTime?     @map("deleted_at")

    company               Company       @relation(fields: [companyId], references: [id])
    branch                Branch        @relation(fields: [branchId], references: [id])

    enrollments           Enrollment[]

    @@map("students")
    @@index([companyId, deletedAt])
    @@index([status])
}