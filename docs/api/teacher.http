@baseUrl = http://localhost:3000/api
@authToken = <paste_token_here>

### Create Teacher
POST {{baseUrl}}/teachers
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "John Doe",
  "email": "john.doe@example.com",
  "status": "active",
  "branch_id": "replace-with-uuid",
  "specialty": "Piano"
}

### Get Teacher List
GET {{baseUrl}}/teachers?page=1&limit=10
Authorization: Bearer {{authToken}}

### Get Teacher by ID
GET {{baseUrl}}/teachers/replace-with-uuid
Authorization: Bearer {{authToken}}

### Update Teacher
PUT {{baseUrl}}/teachers/replace-with-uuid
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "John Doe Updated",
  "status": "active"
}

### Delete Teacher
DELETE {{baseUrl}}/teachers/replace-with-uuid
Authorization: Bearer {{authToken}}
