@baseUrl = http://localhost:3000/api
@authToken = {{login.response.body.data.token}}

### Login
# @name login
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "username": "admin",
  "password": "password"
}

### Create User
POST {{baseUrl}}/users
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "New User",
  "username": "newuser",
  "password": "password123",
  "email": "newuser@example.com",
  "phone": "08123456789",
  "company_id": "replace-with-uuid",
  "role_id": "replace-with-uuid",
  "status": "active"
}

### Get User List
GET {{baseUrl}}/users?page=1&limit=10
Authorization: Bearer {{authToken}}

### Get User by ID
GET {{baseUrl}}/users/replace-with-uuid
Authorization: Bearer {{authToken}}
