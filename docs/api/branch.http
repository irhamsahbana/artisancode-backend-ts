@baseUrl = http://localhost:3000/api
@authToken = <paste_token_here>

### Create Branch
POST {{baseUrl}}/branches
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Central Branch",
  "city": "Jakarta",
  "capacity": 100,
  "status": "active"
}

### Get Branch List
GET {{baseUrl}}/branches?page=1&limit=10
Authorization: Bearer {{authToken}}

### Get Branch by ID
GET {{baseUrl}}/branches/replace-with-uuid
Authorization: Bearer {{authToken}}

### Update Branch
PUT {{baseUrl}}/branches/replace-with-uuid
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Central Branch Updated",
  "city": "Jakarta"
}

### Delete Branch
DELETE {{baseUrl}}/branches/replace-with-uuid
Authorization: Bearer {{authToken}}
